#libevent pkg-config source file

prefix=/home/abi/Drive/workspace/ssrg/ssrg/sgx_sample_applications/porpoise/enclave/libevent/libevent-2.1.11-stable/build/../../install
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libevent_openssl
Description: libevent_openssl adds openssl-based TLS support to libevent
Version: 2.1.11-stable
Requires: libevent
Conflicts:
Libs: -L${libdir} -levent_openssl
Libs.private:  -L/usr/lib/x86_64-linux-gnu -lssl -lcrypto    
Cflags: -I${includedir} 

