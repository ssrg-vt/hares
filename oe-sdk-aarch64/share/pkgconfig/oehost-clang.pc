prefix=${pcfiledir}/../..
exec_prefix=${prefix}
includedir=${prefix}/include
libdir=${prefix}/lib

Name: Open Enclave
Description: Open Enclave clang flags and libraries for building hosts.
Version: 0.19.0
Requires: openssl
Cflags: -fstack-protector-strong -mllvm -x86-speculative-load-hardening -I${includedir} 
Libs: -Wl,-z,noexecstack -L${libdir}/openenclave/host -loehost -ldl -lpthread
