prefix=/home/oe-sdk-aarch64
exec_prefix=${prefix}
includedir=${prefix}/include
libdir=${prefix}/lib

Name: Open Enclave
Description: Open Enclave gcc flags and libraries verifying remote reports on hosts.
Version: 0.19.0
Requires: openssl
Cflags: -fstack-protector-strong -D_FORTIFY_SOURCE=2 -I${includedir}
Libs: -rdynamic -Wl,-z,noexecstack -L${libdir}/openenclave/host -loehostverify -ldl -lpthread
